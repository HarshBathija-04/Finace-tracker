NODE_ENV=development
PORT=5122
# Shared Postgres; this app keeps its tables in schema DB_SCHEMA.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/portfolio
DB_SCHEMA=finance_tracker
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed browser origins
FRONTEND_URL=http://localhost:5211
# https://console.groq.com/keys - AI insights and receipt scanning are disabled without it
GROQ_API_KEY=your-groq-api-key
# Optional
# GROQ_TEXT_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# DEMO_ENABLED=true
