{
  "name": "finsight-api",
  "version": "2.0.0",
  "private": true,
  "description": "FinSight personal finance REST API (Express + PostgreSQL + Groq)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "start:prod": "node src/migrate.js && node src/seed.js && node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/migrate.js",
    "seed": "node src/seed.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "format:check": "prettier --check src test"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "groq-sdk": "1.6.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "multer": "2.5.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "globals": "17.14.0",
    "prettier": "3.10.0",
    "supertest": "7.3.2",
    "vitest": "5.1.0"
  }
}
